{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.axisrobo.com/kinetovela-robot-quarantined.payload.v1.schema.json",
  "title": "KINETOVELA robot.quarantined payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["robot_id", "reason", "authority_ref", "quarantined_at"],
  "properties": {
    "robot_id": { "type": "string", "minLength": 1 },
    "reason": { "type": "string", "minLength": 1 },
    "authority_ref": { "type": "string", "minLength": 1 },
    "quarantined_at": { "type": "string", "format": "date-time" }
  }
}
